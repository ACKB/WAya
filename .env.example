# Configuración del Bot de WhatsApp

# Proveedor de IA: 'local' o 'cloud'
AI_PROVIDER=local

# Configuración IA Local (Compatible con Ollama, LM Studio o cualquier endpoint OpenAI-compatible)
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=qwen2.5:7b

# Configuración IA Cloud (opcional, para cuando pruebes en la nube)
# GOOGLE_GENERATIVE_AI_API_KEY=tu_api_key_de_gemini
# OPENAI_API_KEY=tu_api_key_de_openai
# CLOUD_AI_PROVIDER=gemini

# Google Calendar (Opcional: Si se deja en blanco o no existe credentials.json, usará el modo Local Mock)
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials.json

# Zona horaria del negocio
TIMEZONE=America/Lima
